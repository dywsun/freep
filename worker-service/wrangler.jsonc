{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "relay-subscriptions",
  "main": "dist/worker.js",
  "compatibility_date": "2026-11-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {"enabled": false},
  "d1_databases": [{"binding": "DB", "database_name": "relay-gateway", "database_id": "REPLACE_WITH_D1_DATABASE_ID"}],
  "routes": [{"pattern": "subp.dywsun.dpdns.org", "custom_domain": true}]
}
